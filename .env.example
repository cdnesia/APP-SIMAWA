# Server-only (dibaca lewat runtimeConfig di nuxt.config.ts, TIDAK ada di runtimeConfig.public,
# jadi tidak pernah ke-bundle ke browser). Semua fetch ke backend dilakukan dari Nitro server
# routes (pola BFF), bukan langsung dari browser - lihat server/utils/simawaApi.ts. Divalidasi
# saat startup lewat server/plugins/validate-env.ts.

# Backend SERVICE-SIMAWA (auth, KRS, KHS, EDOM, kegiatan mahasiswa, tagihan, referensi dosen/
# ruang, dst) - satu-satunya backend yang dipanggil APP-SIMAWA. APP-SIMAWA TIDAK punya kredensial
# M2M ke SERVICE-PUBLIC sendiri (dulu ada untuk fitur tagihan, dipindah ke SERVICE-SIMAWA
# 2026-09-19 supaya cuma SERVICE-SIMAWA yang punya kredensial M2M ke service lain).
SIMAWA_API_BASE=http://localhost:4000/api

# Shared secret perimeter server-to-server SERVICE-SIMAWA - WAJIB SAMA PERSIS dengan
# SERVICE_SECRET di .env SERVICE-SIMAWA, lihat server/utils/simawaApi.ts.
SERVICE_SECRET=ganti-dengan-random-string-yang-kuat
