# Server-only (dibaca lewat runtimeConfig di nuxt.config.ts, TIDAK ada di runtimeConfig.public,
# jadi tidak pernah ke-bundle ke browser). Semua fetch ke backend dilakukan dari Nitro server
# routes, bukan langsung dari browser - lihat server/utils/simawaApi.ts. Divalidasi saat startup
# lewat server/plugins/validate-env.ts.

# Backend REST-API-SIMAWA (Laravel) TERMASUK /v1 - satu-satunya backend yang dipanggil APP-SIMAWA.
# Mahasiswa login langsung dengan NPM + password (POST /v1/mahasiswa/login); APP-SIMAWA TIDAK menyimpan
# client_id/secret maupun shared secret apa pun. Token login disimpan di cookie httpOnly Nitro.
#
# Di REST-API-SIMAWA, isi TRUSTED_PROXIES dengan IP server APP-SIMAWA (+ IP proxy di depannya, bila ada)
# agar batas login & throttle per IP memakai IP mahasiswa (header X-Forwarded-For), bukan IP server ini.
SIMAWA_API_BASE=https://rest-api-simawa.test/v1
